# Copy to .env.local and fill in.

# MongoDB connection string. Local: `docker compose up -d` and use the value below.
# Production: your hosted cluster (e.g. MongoDB Atlas).
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=enfinito

# Random secret, at least 32 characters. Encrypts stored credentials (SMTP password).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it later makes the saved SMTP password unreadable (just re-enter it).
APP_SECRET=

# Public URL of the site, used for links in emails.
SITE_URL=http://localhost:3000

# Optional: defaults for `npm run admin:create` (flags override these).
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
